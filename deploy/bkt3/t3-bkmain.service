[Unit]
Description=T3 Code (Beknown bkmain)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/t3code-bkmain
ExecStart=/home/ubuntu/repos/t3code-bkmain/deploy/bkt3/start.sh
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
TimeoutStopSec=30
KillMode=mixed
UMask=0077
LimitNOFILE=65536
# Contain runaway builds/tests spawned inside agent worktrees: throttle
# reclaim at 4G of anonymous memory and OOM-kill within the service at 6G
# instead of taking down the host. Mirrors the drop-ins applied on the box.
MemoryAccounting=yes
MemoryHigh=4G
MemoryMax=6G
TasksMax=4096

[Install]
WantedBy=multi-user.target
