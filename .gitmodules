[submodule ".repos/alchemy-effect/.vendor/alchemy"]
	path = .repos/alchemy-effect/.vendor/alchemy
	url = https://github.com/alchemy-run/alchemy.git
# T3-CUSTOM(expbkt3): BEGIN — the vendored `.repos/alchemy-effect` checkout carries
# gitlinks with no submodule config of their own at this level. `actions/checkout`
# runs `git submodule foreach` to strip credentials and dies with
# "No url found for submodule path" on the first undeclared one, failing every job
# before it starts. Declaring them here is enough; `update = none` keeps CI from
# ever fetching them, matching .repos/alchemy-effect/.gitmodules.
[submodule ".repos/alchemy-effect/.vendor/workers-sdk"]
	path = .repos/alchemy-effect/.vendor/workers-sdk
	url = https://github.com/cloudflare/workers-sdk.git
	shallow = true
	update = none
	ignore = all
[submodule ".repos/alchemy-effect/.vendor/next.js"]
